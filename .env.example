# Optional. Leave unset in production.
# PAYMENT_GATEWAY=razorpay   # "fake" is for browser E2E only; refused when NODE_ENV=production
# ALLOW_TEST_MODES=          # "1" lets `next start` accept PAYMENT_GATEWAY=fake / TURNSTILE_SECRET=test (E2E). Ignored on Vercel.
# LOAD_TEST_DISABLE_RATE_LIMIT=  # "1" (staging load run only, needs ALLOW_TEST_MODES=1): turns off per-IP hold limits. Refused in production otherwise.
